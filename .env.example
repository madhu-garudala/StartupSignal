# Required only for live investigations. Demo mode is always available without a key.
OPENAI_API_KEY=

# Override when a different Responses API model is preferred.
OPENAI_MODEL=gpt-5.6-terra

# Optional model for first-party indexed-source fallback when direct crawling is blocked.
OPENAI_SEARCH_MODEL=gpt-5.6-luna

# Optional public origin used in generated metadata.
NEXT_PUBLIC_APP_URL=http://localhost:3000
